# =============================================================================
# AccessBridge AI — environment configuration template
# =============================================================================
# Copy this file to `.env` at the repository root and fill in the values.
# Never commit your real `.env`. The `.gitignore` excludes it.
#
#   cp .env.example .env
#
# All values are optional for local development. The project runs in a fully
# functional offline/deterministic mode when no LLM or Switch tokens are set.
# =============================================================================

# --- Core runtime ---
ACCESSBRIDGE_ENV=development
ACCESSBRIDGE_HOST=0.0.0.0
ACCESSBRIDGE_PORT=8000
ACCESSBRIDGE_LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (the Vite dev server is default).
ACCESSBRIDGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Defaults to ./data/accessbridge.db (SQLite). Override only if you need a
# different path or a real Postgres/MySQL in production.
# ACCESSBRIDGE_DATABASE_URL=sqlite:///./data/accessbridge.db

# --- LLM (any OpenAI-compatible endpoint) ---
# Leave empty to run in deterministic-fallback mode (no external calls).
# Set llm_provider to a preset and the base_url + model are filled in
# automatically:
#   openai  → https://api.openai.com/v1 (gpt-4o-mini)
#   asi1    → https://api.asi1.ai/v1 (Fetch.ai ASI-1 Mini — agent-ready)
#   groq    → https://api.groq.com/openai/v1 (llama-3.3-70b-versatile)
#   ollama  → http://localhost:11434/v1 (qwen2.5:7b)
#   custom  → use whatever you set in ACCESSBRIDGE_LLM_BASE_URL
ACCESSBRIDGE_LLM_PROVIDER=openai
ACCESSBRIDGE_LLM_BASE_URL=https://api.openai.com/v1
ACCESSBRIDGE_LLM_API_KEY=
ACCESSBRIDGE_LLM_MODEL=gpt-4o-mini
ACCESSBRIDGE_LLM_TIMEOUT_SECONDS=45
ACCESSBRIDGE_LLM_MAX_TOKENS=1200
# OPENAI_API_KEY is also honoured as a fallback for ACCESSBRIDGE_LLM_API_KEY.

# To use Fetch.ai ASI-1 Mini instead:
#   ACCESSBRIDGE_LLM_PROVIDER=asi1
#   ACCESSBRIDGE_LLM_API_KEY=<your ASI-1 key from https://superintelligence.io>

# --- Switch Trust guardrails ---
# Switch Trust wraps every LLM call from every agent with policy guardrails.
# When not configured, the SDK runs in pass-through mode and logs a warning,
# so local development still works.
ACCESSBRIDGE_SWITCH_TRUST_ENABLED=true
ACCESSBRIDGE_SWITCH_TRUST_GATEWAY_URL=https://api.switchagents.ai
ACCESSBRIDGE_SWITCH_TRUST_API_KEY=
ACCESSBRIDGE_SWITCH_TRUST_POLICY_ID=
# Set to true in production to refuse to run without guardrails.
ACCESSBRIDGE_SWITCH_TRUST_REQUIRE_GUARDRAILS=false

# --- Switch Console / Agent Bridge ---
# The Switch Console desktop app calls our /switch/bridge endpoint to dispatch
# a room message to the orchestrator. This token is what Switch presents on
# every inbound request; we verify it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESSBRIDGE_SWITCH_BRIDGE_TOKEN=
ACCESSBRIDGE_SWITCH_BRIDGE_PUBLIC_URL=http://localhost:8000

# --- Mattermost (chat platform transport) ---
# Either a bot token (preferred) or a per-channel incoming webhook works.
ACCESSBRIDGE_MATTERMOST_ENABLED=false
ACCESSBRIDGE_MATTERMOST_BASE_URL=
ACCESSBRIDGE_MATTERMOST_BOT_TOKEN=
ACCESSBRIDGE_MATTERMOST_INCOMING_WEBHOOK_URL=
# Channel names — create these in your Mattermost team.
ACCESSBRIDGE_MATTERMOST_CHANNEL_STUDENT_QUESTIONS=student-questions
ACCESSBRIDGE_MATTERMOST_CHANNEL_RESEARCH_UPDATES=research-updates
ACCESSBRIDGE_MATTERMOST_CHANNEL_TRANSLATION=translation
ACCESSBRIDGE_MATTERMOST_CHANNEL_HUMAN_REVIEW=human-review
ACCESSBRIDGE_MATTERMOST_CHANNEL_FINAL_GUIDANCE=final-guidance

# --- Discord (https://discord.com/developers/applications) ---
ACCESSBRIDGE_DISCORD_BOT_TOKEN=
ACCESSBRIDGE_DISCORD_CHANNEL_ID=

# --- Slack (https://api.slack.com/apps, scope: chat:write) ---
ACCESSBRIDGE_SLACK_BOT_TOKEN=
ACCESSBRIDGE_SLACK_CHANNEL=

# --- Telegram (bot token from @BotFather, chat_id from /getUpdates) ---
ACCESSBRIDGE_TELEGRAM_BOT_TOKEN=
ACCESSBRIDGE_TELEGRAM_CHAT_ID=

# --- Microsoft Teams (outbound only; inbound needs Azure Bot Service) ---
ACCESSBRIDGE_TEAMS_INCOMING_WEBHOOK_URL=

# --- Fetch.ai uAgents (independent processes, optional) ---
# The orchestrator runs agents in embedded mode by default. To run them as
# independent uAgent processes (genuine inter-process messaging), start them
# with `scripts/run_agents.sh` and set these ports.
ACCESSBRIDGE_AGENTS_ENABLED=true
ACCESSBRIDGE_AGENTS_RESEARCH_PORT=8001
ACCESSBRIDGE_AGENTS_LANGUAGE_PORT=8002
ACCESSBRIDGE_AGENTS_GUIDANCE_PORT=8003
# CHANGE THIS SEED in production. It derives the agents' Fetch.ai addresses.
ACCESSBRIDGE_AGENTS_SEED=accessbridge-dev-seed-change-me

# --- Knowledge retrieval ---
ACCESSBRIDGE_KNOWLEDGE_OFFLINE_FALLBACK=true
ACCESSBRIDGE_KNOWLEDGE_REQUEST_TIMEOUT_SECONDS=12.0
ACCESSBRIDGE_KNOWLEDGE_USER_AGENT=AccessBridgeAI/0.1 (+https://github.com/accessbridge-ai)

# --- Security ---
# Required for the /api/review/* approve/reject endpoints. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESSBRIDGE_REVIEW_APPROVAL_SECRET=
ACCESSBRIDGE_RATE_LIMIT_PER_MINUTE=60
ACCESSBRIDGE_UPLOAD_MAX_BYTES=2097152
